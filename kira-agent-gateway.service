[Unit]
Description=Kira/Jarvis system-connector agent gateway
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/kira-chat-backend
EnvironmentFile=/opt/kira-chat-backend/.env
ExecStart=/opt/kira-chat-backend/.venv/bin/python agent_gateway.py
Restart=on-failure
RestartSec=3
User=root

[Install]
WantedBy=multi-user.target

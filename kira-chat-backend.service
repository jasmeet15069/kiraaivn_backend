[Unit]
Description=Kira chat backend (Jarvis frontend persona)
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/kira-chat-backend
EnvironmentFile=/opt/kira-chat-backend/.env
ExecStart=/opt/kira-chat-backend/.venv/bin/gunicorn -w 2 -b 127.0.0.1:5001 app:app
Restart=on-failure
RestartSec=3
User=root

[Install]
WantedBy=multi-user.target

KIRA_API_KEY=your-kira-api-key-here
KIRA_BASE_URL=https://kiraai.vn/api/v1
KIRA_CHAT_PATH=/chat/completions
PORT=5001

# Local model routing (optional — defaults match the on-box llama.cpp servers / Ollama)
LLAMA_QWEN_API_KEY=
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Ollama Cloud (hosted, larger models via an ollama.com account) — optional,
# the model only appears in /api/models once a key is set.
OLLAMA_CLOUD_API_KEY=
OLLAMA_CLOUD_BASE_URL=https://ollama.com/v1
OLLAMA_CLOUD_MODEL=nemotron-3-ultra:cloud

# System connector: outbound-only agent gateway (see agent_gateway.py).
# AGENT_GATEWAY_TOKEN is the shared secret agent_client.py authenticates
# with — generate a long random value, never reuse it elsewhere.
AGENT_GATEWAY_TOKEN=
AGENT_GATEWAY_PORT=5002
AGENT_GATEWAY_URL=http://127.0.0.1:5002

# Background tasks (worker.py): email sent when a task finishes.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
NOTIFY_EMAIL=
